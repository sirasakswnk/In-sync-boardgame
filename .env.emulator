# ค่าสำหรับ Firebase Local Emulator เท่านั้น — ไม่มีความลับ (project "demo-*" ใช้ได้เฉพาะในเครื่อง)
# ใช้ผ่าน: npm run dev:emulator / npm run test:e2e:emulator
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-heart-sync.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-heart-sync
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://demo-heart-sync-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FIREBASE_EMULATOR=1
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
CRON_SECRET=emulator-only-cron-secret
