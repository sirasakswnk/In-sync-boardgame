{
  "name": "heart-sync",
  "version": "0.1.0",
  "private": true,
  "description": "ใจตรงกันแค่ไหน — เว็บเกมจัดอันดับสำหรับผู้เล่นสองคน",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project integration",
    "check:questions": "tsx scripts/check-questions.ts",
    "rules:deploy": "npx --yes firebase-tools@15.30.2 deploy --only database",
    "emulators": "npx --yes firebase-tools@15.30.2 emulators:start --only auth,database --project demo-heart-sync",
    "dev:emulator": "node scripts/with-env.mjs .env.emulator next dev",
    "test:e2e:emulator": "node scripts/emulator-tests.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/noto-sans-thai": "5.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.4.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
