# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง — .env.local ถูก ignore ไว้แล้ว
# ห้ามใส่ค่าจริงลงในไฟล์นี้ และห้าม commit .env.local
# ---------------------------------------------------------------------------

# origin ที่เบราว์เซอร์ใช้เปิดเว็บ ต้องตรงเป๊ะ (ใช้ตรวจ Origin header ของทุก mutation)
# ทดสอบผ่าน LAN ให้เปลี่ยนเป็น http://192.168.x.x:3000 ตาม IP เครื่องที่รัน
APP_ORIGIN=http://localhost:3000

# --- Firebase web config (ฝั่ง client, ไม่ใช่ความลับ แต่ต้องตรงกับ project) ---
# หาได้จาก Firebase console → Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyReplaceMe
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Firebase admin (ฝั่ง server, เป็นความลับ) ---
# Firebase console → Project settings → Service accounts → Generate new private key
# วาง JSON ทั้งก้อนเป็นบรรทัดเดียว ครอบด้วย single quote
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# ความลับสำหรับป้องกัน /api/cron/cleanup (Vercel Cron ส่งมาใน Authorization header)
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=replace-with-a-long-random-string

# --- ใช้เฉพาะตอนพัฒนา/ทดสอบ (ห้ามตั้งใน production) ---
# ชี้ไปที่ Firebase emulator แทน project จริง เช่น 127.0.0.1:9000
# FIREBASE_DATABASE_EMULATOR_HOST=
# seed คงที่ให้การสุ่มคำถาม/ลำดับการ์ดทำซ้ำได้ ใช้ใน integration test เท่านั้น
# HS_TEST_SEED=
